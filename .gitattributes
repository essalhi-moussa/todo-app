# =============================================================================
#  Normalisation des fins de ligne.
#
#  CRITIQUE pour ce projet : le depot est edite sous Windows mais TOUT est
#  execute sous Linux (WSL, noeuds provisionnes, conteneurs, cluster). Un
#  script shell recupere avec des fins de ligne CRLF echoue immediatement :
#      bash: infra/00-bootstrap-wsl.sh: /usr/bin/env: bad interpreter: ^M
#  De meme, un Dockerfile ou un playbook Ansible en CRLF provoque des erreurs
#  difficiles a diagnostiquer.
#
#  « eol=lf » impose donc LF dans le depot ET dans la copie de travail, quelle
#  que soit la configuration core.autocrlf de la machine.
# =============================================================================

# Par defaut : detection automatique du texte, toujours normalise en LF.
* text=auto eol=lf

# --------------------------------------------------- fichiers executes sous Linux
*.sh          text eol=lf
*.bash        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.j2          text eol=lf
*.tf          text eol=lf
*.tftpl       text eol=lf
*.hcl         text eol=lf
*.sql         text eol=lf
*.js          text eol=lf
*.json        text eol=lf
*.cfg         text eol=lf
*.ini         text eol=lf
*.conf        text eol=lf
*.service     text eol=lf
Dockerfile    text eol=lf
Jenkinsfile   text eol=lf
.gitignore    text eol=lf
.dockerignore text eol=lf

# ------------------------------------------------ scripts sans extension (hooks)
scripts/git-hooks/pre-commit text eol=lf
scripts/git-hooks/commit-msg text eol=lf
scripts/git-hooks/pre-push   text eol=lf

# ------------------------------------------------------------ fichiers binaires
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.gz   binary
*.tgz  binary
*.zip  binary

# ---------------------------------------------- statistiques de langage (GitHub)
# Le verrou de dependances n'est pas du code ecrit a la main.
app/package-lock.json linguist-generated=true
