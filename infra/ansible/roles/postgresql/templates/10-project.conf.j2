# =============================================================================
#  Configuration PostgreSQL du projet {{ project_name }}
#  GENERE PAR ANSIBLE — role postgresql. Ne pas editer a la main.
# =============================================================================

# Ecoute sur le reseau prive du projet pour que le noeud Jenkins puisse lancer
# ses tests d'integration contre cette instance.
listen_addresses = '{{ postgres_listen_addresses }}'
port = 5432

# Dimensionnement volontairement modeste : ce noeud partage sa memoire avec
# minikube et NGINX.
max_connections = 60
shared_buffers = 128MB
work_mem = 4MB
maintenance_work_mem = 64MB

# Journalisation utile au diagnostic pendant les demonstrations.
log_line_prefix = '%m [%p] %u@%d '
log_min_duration_statement = 500
log_connections = on
log_disconnections = off

# scram-sha-256 est l'algorithme attendu par les regles pg_hba du projet.
password_encryption = scram-sha-256

timezone = '{{ timezone }}'
